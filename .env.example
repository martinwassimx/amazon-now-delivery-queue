# ==============================================================================
# Amazon Now Delivery Queue System - Environment Configuration
# إعدادات البيئة لنظام طابور التوصيل (العامية المصرية)
# ==============================================================================

# Supabase API Credentials
# احصل على هذه القيم من إعدادات مشروع Supabase الخاص بك: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Base URL (Used for generating QR Codes and Ticket Links)
# رابط التطبيق المستخدم لإنشاء روابط الـ QR وتذاكر السائقين
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default Pickup Location ID
# معرف موقع الاستلام الافتراضي (محطة القاهرة)
NEXT_PUBLIC_DEFAULT_SITE_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEFAULT_SITE_NAME=محطة توزيع أمازون ناو — الهرم

# Staff Demo Login (Optional for local testing if Supabase Auth is not yet configured)
# إمكانية الدخول التجريبي لفريق العمل أثناء التطوير المحلي
NEXT_PUBLIC_ENABLE_DEMO_STAFF=true
